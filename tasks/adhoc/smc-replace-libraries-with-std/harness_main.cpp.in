// Harness for number_helper_oracle.py: the two marker lines below are replaced by
// the old and new helper-function regions of core/property_helper.cpp.
#include <algorithm>
#include <array>
#include <bit>
#include <cctype>
#include <charconv>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <fstream>
#include <limits>
#include <random>
#include <sstream>
#include <string>
#include <vector>

using Uint64 = std::uint64_t;

namespace old_impl {
@OLD@
}
namespace new_impl {
@NEW@
}

static int mismatches = 0;

template <class T>
static void check(const char* what, const std::string& in, T a, T b) {
  bool same;
  if constexpr (std::is_floating_point_v<T>) {
    same = (std::isnan(a) && std::isnan(b)) || std::bit_cast<std::uint32_t>(a) == std::bit_cast<std::uint32_t>(b);
  } else {
    same = a == b;
  }
  if (!same && ++mismatches <= 40) {
    std::ostringstream os;
    os << what << "(\"" << in << "\"): old=" << a << " new=" << b;
    std::puts(os.str().c_str());
  }
}

static void check_str(const char* what, double v, int prec, bool keep, const std::string& a, const std::string& b) {
  if (a != b && ++mismatches <= 40) {
    std::printf("%s(%.17g, %d, %d): old=\"%s\" new=\"%s\"\n", what, v, prec, keep, a.c_str(), b.c_str());
  }
}

int main(int argc, char** argv) {
  std::vector<std::string> inputs = {"", " 12", "+7", "-3", "0", "-0", "1.5", ".5", "5.", "-0.25",
                                     "12abc", "abc", "1e3", "2147483647", "18446744073709551615"};
  if (argc > 1) {
    std::ifstream f(argv[1]);
    for (std::string line; std::getline(f, line);) inputs.push_back(line);
  }
  std::vector<double> doubles = {0.0, -0.0, 0.5, 1.5, 2.5, -1.5, 0.125, 0.999999, 1e-7, 123.456789,
                                 -987.654321, 2147483646.5, 1234567.0};
  for (const auto& s : inputs) {
    check("string_to_int", s, old_impl::string_to_int(s), new_impl::string_to_int(s));
    check("string_to_long", s, old_impl::string_to_long(s), new_impl::string_to_long(s));
    check("string_to_int64", s, old_impl::string_to_int64(s), new_impl::string_to_int64(s));
    float const f = old_impl::string_to_float(s);
    check("string_to_float", s, f, new_impl::string_to_float(s));
    doubles.push_back(f);
  }
  std::mt19937 rng(12345);
  std::uniform_real_distribution<double> dist(-5000.0, 5000.0);
  for (int i = 0; i < 20000; ++i) doubles.push_back(dist(rng));
  for (double v : doubles) {
    for (int prec = 0; prec <= 6; ++prec) {
      for (bool keep : {true, false}) {
        check_str("float_to_string", v, prec, keep, old_impl::float_to_string(v, prec, keep),
                  new_impl::float_to_string(v, prec, keep));
      }
    }
  }
  for (int i : {0, -1, 42, std::numeric_limits<int>::max(), std::numeric_limits<int>::min()}) {
    if (old_impl::int_to_string(i) != new_impl::int_to_string(i)) ++mismatches;
  }
  std::printf("inputs=%zu doubles=%zu mismatches=%d\n", inputs.size(), doubles.size(), mismatches);
  return mismatches ? 1 : 0;
}
