	<FileVersion major="1" minor="1"/>
	<Project>
		<Option title="Secret Maryo Chronicles"/>
		<Option makefile="Makefile"/>
		<Option makefile_is_custom="0"/>
		<Option active_target="1"/>
		<Option compiler="1"/>
		<Build>
			<Target title="Optimized">
				<Option output="Secret Maryo Chronicles.exe"/>
				<Option working_dir="..\..\"/>
				<Option object_output=".objs_optimized"/>
				<Option deps_output=".deps"/>
				<Option external_deps=""/>
				<Option type="0"/>
				<Option compiler="1"/>
				<Option projectResourceIncludeDirsRelation="0"/>
				<Compiler>
					<Add option="-O2"/>
					<Add option="-O1"/>
					<Add option="-O"/>
				</Compiler>
			</Target>
			<Target title="Default">
				<Option output="Secret Maryo ChroniclesD.exe"/>
				<Option working_dir="..\..\"/>
				<Option object_output=".objs"/>
				<Option deps_output=".deps"/>
				<Option external_deps=""/>
				<Option type="1"/>
				<Option compiler="1"/>
				<Option projectResourceIncludeDirsRelation="1"/>
				<Compiler>
					<Add option="/GX"/>
				</Compiler>
			</Target>
		</Build>
		<Compiler>
