# google style like gltron, but with three keys added so the pass is layout-only:
# it changes whitespace/indent/braces/wrapping and NOTHING else (proven token-identical
# across all of smc/src, 2026-09-23). Each added key stops a google default that would
# rewrite or reorder tokens rather than just reformat.
BasedOnStyle: google
SortIncludes: Never            # keep the include order as written
ReflowComments: false          # keep the /* *** *** */ banners (546 exceed 80 cols) intact
SortUsingDeclarations: false   # don't alphabetize `using std::x;` (same intent as SortIncludes)
BreakStringLiterals: false     # don't split long string literals to fit 80 cols
