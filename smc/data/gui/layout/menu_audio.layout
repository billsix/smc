<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="DefaultWindow" Name="menu_audio" >
        <Property Name="InheritsAlpha" Value="False" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Window Type="TaharezLook/Combobox" Name="combo_music" >
            <Property Name="Text" Value="Music" />
            <Property Name="Tooltip" Value="Enable this to play music. You need to have the Music Addon installed" />
            <Property Name="ReadOnly" Value="True" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="ClippedByParent" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0.5,0},{0.51,0},{0.6,0},{0.65,0}}" />
            <Property Name="MaxEditTextLength" Value="1073741823" />
        </Window>
        <Window Type="TaharezLook/Combobox" Name="combo_sounds" >
            <Property Name="Text" Value="Sounds" />
            <Property Name="Tooltip" Value="Enable to play Sounds." />
            <Property Name="ReadOnly" Value="True" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="ClippedByParent" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0.5,0},{0.6,0},{0.6,0},{0.74,0}}" />
            <Property Name="MaxEditTextLength" Value="1073741823" />
        </Window>
        <Window Type="TaharezLook/Slider" Name="slider_music_volume" >
            <Property Name="Tooltip" Value="Set the Game Music Volume." />
            <Property Name="CurrentValue" Value="0" />
            <Property Name="MaximumValue" Value="128" />
            <Property Name="ClickStepSize" Value="5" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="UnifiedAreaRect" Value="{{0.615,0},{0.49,0},{0.635,0},{0.57,0}}" />
        </Window>
        <Window Type="TaharezLook/Slider" Name="slider_sound_volume" >
            <Property Name="Tooltip" Value="Set the Game Sound Volume." />
            <Property Name="CurrentValue" Value="0" />
            <Property Name="MaximumValue" Value="128" />
            <Property Name="ClickStepSize" Value="5" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="UnifiedAreaRect" Value="{{0.615,0},{0.58,0},{0.635,0},{0.66,0}}" />
        </Window>
        <Window Type="TaharezLook/Combobox" Name="combo_audio_hz" >
            <Property Name="Text" Value="Hz" />
            <Property Name="Tooltip" Value="Never change this except if audio is scratchy." />
            <Property Name="ReadOnly" Value="True" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="ClippedByParent" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0.5,0},{0.37,0},{0.64,0},{0.51,0}}" />
            <Property Name="MaxEditTextLength" Value="1073741823" />
        </Window>
    </Window>
</GUILayout>
