<?xml version="1.0" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

	<xsd:element name="Overworld" type="OverworldType" />
	
	<xsd:complexType name="OverworldType">
		<xsd:sequence>
			<xsd:element name="Sprite" type="SpriteType" maxOccurs="unbounded"/>
			<xsd:element name="Waypoint" type="WaypointType" maxOccurs="unbounded"/>
			<xsd:element name="Layer" type="LayerType" maxOccurs="unbounded"/>
			<xsd:element name="Player" type="PlayerType" maxOccurs="1"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="SpriteType">
		<xsd:attribute name="Filename" type="xsd:string" />
		<xsd:attribute name="PosX" type="xsd:integer" />
		<xsd:attribute name="PosY" type="xsd:integer" />
	</xsd:complexType>

	<xsd:complexType name="WaypointType">
		<xsd:attribute name="PosX" type="xsd:integer" />
		<xsd:attribute name="PosY" type="xsd:integer" />
		<xsd:attribute name="Type" type="xsd:integer" />
		<xsd:attribute name="LevelName" type="xsd:string" />
		<xsd:attribute name="Dir_Back" type="xsd:string" />
		<xsd:attribute name="Dir_For" type="xsd:string" />
		<xsd:attribute name="Access" type="xsd:integer" />
	</xsd:complexType>

	<xsd:complexType name="LayerType">
		<xsd:attribute name="Filename" type="xsd:string" />
		<xsd:attribute name="PosX" type="xsd:integer" />
		<xsd:attribute name="PosY" type="xsd:integer" />
	</xsd:complexType>

	<xsd:complexType name="PlayerType">
		<xsd:attribute name="Waypoint" type="xsd:integer" />
		<xsd:attribute name="State" type="xsd:integer" />
	</xsd:complexType>
</xsd:schema>